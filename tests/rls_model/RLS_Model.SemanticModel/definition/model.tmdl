model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

queryGroup RLS

	annotation PBI_QueryGroupOrder = 0

queryGroup OLS

	annotation PBI_QueryGroupOrder = 1

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_ProTooling = ["TMDLView_Desktop","DaxQueryView_Desktop","DevMode","TMDL-Extension","MCP-PBIModeling"]

annotation PBI_QueryOrder = ["Groups","Group Fact","Admin Table","Hidden Column Table"]

annotation __TEdtr = 1

ref table Groups
ref table 'Group Fact'
ref table 'Admin Table'
ref table 'Hidden Column Table'

ref role West
ref role East
ref role Admin

ref cultureInfo en-US

