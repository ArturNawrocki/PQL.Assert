EVALUATE INFO.USERDEFINEDFUNCTIONS()
EVALUATE
NATURALINNERJOIN(
    SELECTCOLUMNS(INFO.USERDEFINEDFUNCTIONS(),"ID",[ID],"Name",[Name]),
    SELECTCOLUMNS(
        INFO.ANNOTATIONS(),
        "ID",               [ObjectID],
        "Annotation.Name",  [Name],
        "Annotation.Value", [Value],
        "ObjectType",       [ObjectType]
    )
)
ORDER BY [ID]
