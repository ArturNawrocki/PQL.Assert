DEFINE
	FUNCTION Security.ANY.Tests = () =>
	// ============================================
	// Security Assertion Test Suite
	// Tests for PQL.Assert.ShouldThrow and PQL.Assert.ShouldNotThrow
	//
	// These functions are used to validate Object Level Security (OLS):
	//   - ShouldThrow: verifies that accessing a secured table or column throws
	//     an error, confirming security is properly applied.
	//   - ShouldNotThrow: verifies that an accessible expression does not throw
	//     an error, confirming access is available.
	//
	// OLS Example Usage:
	//   PQL.Assert.ShouldThrow("Secured table should be inaccessible",
	//       COUNTROWS('SensitiveTable'))
	//   PQL.Assert.ShouldNotThrow("Public table should be accessible",
	//       COUNTROWS('PublicTable'))
	// ============================================
	VAR _ShouldThrow_Pass =
		PQL.Assert.ShouldThrow(
			"ShouldThrow: ERROR() expression should pass",
			ERROR("intentional test error")
		)
	VAR _ShouldThrow_Fail =
		PQL.Assert.ShouldThrow(
			"ShouldThrow: valid expression should fail",
			1 + 1
		)
	VAR _ShouldNotThrow_Pass =
		PQL.Assert.ShouldNotThrow(
			"ShouldNotThrow: valid expression should pass",
			COUNTROWS('TestData')
		)
	VAR _ShouldNotThrow_Fail =
		PQL.Assert.ShouldNotThrow(
			"ShouldNotThrow: ERROR() expression should fail",
			ERROR("intentional test error")
		)
	RETURN UNION(
		_ShouldThrow_Pass,
		_ShouldThrow_Fail,
		_ShouldNotThrow_Pass,
		_ShouldNotThrow_Fail
	)

EVALUATE Security.ANY.Tests()
