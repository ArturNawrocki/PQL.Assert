DEFINE

// ============================================
// Perspective Assertion Test Suite
// Tests for PQL.Assert.Perspective assertions
// Target perspective definition: Just SharePoint
// ============================================

FUNCTION Perspective.ANY.Tests = () =>
    // Test 1: Perspective exists
    VAR _Test1 = PQL.Assert.Perspective.ShouldExist(
        "Perspective.ShouldExist: 'Just SharePoint' should exist",
        "Just SharePoint"
    )

    // Test 2: Perspective contains exact expected tables, columns, and measures
    VAR _ExpectedTables = DATATABLE(
        "Name", STRING,
        {
            {"Test Import 1 & 3"},
            {"Mock-Fact"}
        }
    )

    VAR _ExpectedColumns = DATATABLE(
        "Name", STRING,
        {
            {"Test Import 1 & 3[project_name]"},
            {"Test Import 1 & 3[project_description]"},
            {"Test Import 1 & 3[start_date]"},
            {"Test Import 1 & 3[end_date]"},
            {"Test Import 1 & 3[project_manager]"},
            {"Test Import 1 & 3[project_budget]"},
            {"Test Import 1 & 3[project_status]"},
            {"Test Import 1 & 3[client_name]"},
            {"Test Import 1 & 3[client_email]"},
            {"Test Import 1 & 3[client_phone]"},
            {"Mock-Fact[Date ID]"}
        }
    )

    VAR _ExpectedMeasures = DATATABLE(
        "Name", STRING,
        {
            {"Test Import 1 & 3[Row Count]"}
        }
    )

    VAR _Test2 = PQL.Assert.Perspective.ShouldContain(
        "Perspective.ShouldContain: 'Just SharePoint' should contain expected tables, columns, and measures",
        "Just SharePoint",
        _ExpectedTables,
        _ExpectedColumns,
        _ExpectedMeasures
    )

    RETURN UNION(
        _Test1,
        _Test2
    )

EVALUATE Perspective.ANY.Tests()
