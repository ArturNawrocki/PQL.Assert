/// Asserts that all text values in a column match the specified pattern.
function 'PQL.Assert.Col.TextShouldMatchPattern' =
		(testName : STRING, columnRef : ANYREF EXPR, pattern : STRING) =>
			VAR _TotalCount = COUNTROWS(ALLNOBLANKROW(columnRef))
			VAR _NonMatchCount = COUNTAX(ALLNOBLANKROW(columnRef), IF(NOT ISBLANK(columnRef) && NOT CONTAINSSTRING(FORMAT(columnRef, ""), pattern), 1, BLANK()))
			VAR _Passed = _NonMatchCount = 0
			RETURN ROW(
				"TestName", testName,
				"Expected", "All values match pattern '" & pattern & "'",
				"Actual", IF(_Passed, "ALL MATCH (" & FORMAT(_TotalCount, "0") & " rows)", "NON-MATCHING VALUES (" & FORMAT(_NonMatchCount, "0") & " of " & FORMAT(_TotalCount, "0") & ")"),
				"Passed", _Passed
			)
	lineageTag: 7d73311b-bd4d-4b68-a154-b0b7d414fcb9

	annotation DAXLIB_PackageId = PQL.Assert

	annotation DAXLIB_PackageVersion = 0.1.9

