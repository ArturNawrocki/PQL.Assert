			VAR _MatchCount = COUNTAX(ALLNOBLANKROW(columnRef), IF(NOT ISBLANK(columnRef) && CONTAINSSTRING(FORMAT(columnRef, ""), pattern), 1, BLANK()))
			VAR _Passed = _MatchCount = 0
